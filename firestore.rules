rules_version = '2';

// Regras do Firestore do cardápio + painel.
// Cole tudo isto em: Firebase Console → Firestore Database → Regras → Publicar.
// UID do dono já preenchido abaixo (JnZbWc4Z8AbYWgQ655IvtvRxfjG2).
// Se trocar o dono, mude o UID aqui, no storage.rules e no painel.html.

service cloud.firestore {
  match /databases/{database}/documents {

    function isDono() {
      return request.auth != null && request.auth.uid == "JnZbWc4Z8AbYWgQ655IvtvRxfjG2";
    }

    // Cardápio: qualquer pessoa vê, só o dono altera pelo painel.
    match /categorias/{id} {
      allow read: if true;
      allow write: if isDono();
    }
    match /produtos/{id} {
      allow read: if true;
      allow write: if isDono();
    }
    match /adicionais/{id} {
      allow read: if true;
      allow write: if isDono();
    }
    match /delivery_neighborhoods/{id} {
      allow read: if true;
      allow write: if isDono();
    }

    // Pedidos: o cliente (mesmo anônimo) cria e acompanha só os dele;
    // o dono vê e altera todos no painel.
    match /pedidos/{id} {
      allow create: if request.auth != null
                    && request.resource.data.clienteUid == request.auth.uid;
      allow read: if isDono()
                  || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      allow update, delete: if isDono();
    }

    // Dados e endereços do cliente: só o próprio cliente.
    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /enderecos/{enderecoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
