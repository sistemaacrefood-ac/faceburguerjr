rules_version = '2';

// Regras do Firestore — Face Burguer JR (projeto faceburguerjr-7948a)
// Cardápio (index.html): leitura pública do cardápio; o cliente (anônimo ou
// com conta) cria pedidos e lê só os próprios pedidos/perfil/endereços.
// Painel (painel.html): só contas com e-mail confirmado e documento em
// admins/{uid}. A primeira conta confirmada vira o dono (config/dono); depois,
// só entra quem o dono liberar em config/acesso.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function emailConfirmado() {
      return logado() && request.auth.token.get('email_verified', false) == true;
    }
    function emailAtual() { return request.auth.token.get('email', '').lower(); }
    function caminhoDono() { return /databases/$(database)/documents/config/dono; }
    function caminhoAcesso() { return /databases/$(database)/documents/config/acesso; }
    function ehAdmin() {
      return emailConfirmado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function ehDono() {
      return emailConfirmado()
        && exists(caminhoDono())
        && get(caminhoDono()).data.uid == request.auth.uid;
    }

    // ---------- Cardápio (público para leitura) ----------
    match /categorias/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /produtos/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /delivery_neighborhoods/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /adicionais/{id} {
      allow read: if true;
      allow delete: if ehAdmin();
      allow create, update: if ehAdmin() && grupoValido(request.resource.data);
    }
    function grupoValido(d) {
      return d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 60
        && d.obrigatorio is bool
        && d.max is number && d.max >= 1 && d.max <= 99
        && (!('min' in d) || (d.min is number && d.min >= 0 && d.min <= d.max))
        && d.opcoes is list && d.opcoes.size() <= 80;
    }

    // ---------- Pedidos ----------
    match /pedidos/{id} {
      allow create: if ehAdmin() || (
        logado()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.status == "novo"
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0
      );
      allow read: if ehAdmin()
        || (logado() && resource.data.clienteUid == request.auth.uid);
      allow update, delete: if ehAdmin();
    }

    // ---------- Clientes (cada um só mexe no que é dele) ----------
    match /clientes/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
      match /enderecos/{enderecoId} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }

    // ---------- Controle de acesso do painel ----------
    match /config/dono {
      allow get: if logado();
      // Só pode ser criado uma vez, junto com admins/{uid} (mesmo lote).
      allow create: if emailConfirmado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == emailAtual()
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }
    match /config/acesso {
      allow read: if ehAdmin();
      allow create, update: if ehDono()
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 50;
      allow delete: if ehDono();
    }
    match /admins/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow list: if ehAdmin();
      allow create: if emailConfirmado()
        && request.auth.uid == uid
        && request.resource.data.email == emailAtual()
        && (
          // 1) primeira conta: vira o dono (config/dono criado no mesmo lote)
          (!exists(caminhoDono())
            && existsAfter(caminhoDono())
            && getAfter(caminhoDono()).data.uid == uid)
          ||
          // 2) e-mail liberado pelo dono em 👥 Acessos
          (exists(caminhoAcesso())
            && emailAtual() in get(caminhoAcesso()).data.emails)
        );
      allow update: if false;
      allow delete: if ehDono() && uid != request.auth.uid;
    }
  }
}
